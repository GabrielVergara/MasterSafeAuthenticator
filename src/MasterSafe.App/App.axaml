<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MasterSafe.App"
             x:Class="MasterSafe.App.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#D9E2E8" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
          <SolidColorBrush x:Key="CodeBrush" Color="#12263A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBrush" Color="#16222F" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#27384A" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F07167" />
          <SolidColorBrush x:Key="CodeBrush" Color="#E8F1F2" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static local:App.HighContrastVariant}">
          <SolidColorBrush x:Key="CardBrush" Color="#000000" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FFD400" />
          <SolidColorBrush x:Key="CodeBrush" Color="#FFFFFF" />
          <!-- The accent follows the high contrast colour; the rest comes from the dark theme this one is built on. -->
          <Color x:Key="SystemAccentColor">#FFD400</Color>
          <Color x:Key="SystemAccentColorLight1">#FFE55C</Color>
          <Color x:Key="SystemAccentColorLight2">#FFF099</Color>
          <Color x:Key="SystemAccentColorLight3">#FFF7CC</Color>
          <Color x:Key="SystemAccentColorDark1">#FFD400</Color>
          <Color x:Key="SystemAccentColorDark2">#E6BF00</Color>
          <Color x:Key="SystemAccentColorDark3">#CCA900</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#17806B" RegionColor="#F4F7F9" />
        <ColorPaletteResources x:Key="Dark" Accent="#2CC3A5" RegionColor="#0F1B27" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Typography -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource CodeBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C9D6DF" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A324A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#24476A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
      <!-- Easier reading (WCAG 1.4.12 text spacing): more room between letters and lines, on every screen. -->
    <Style Selector="Window.easyRead TextBlock">
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="LineSpacing" Value="6" />
    </Style>
    <Style Selector="Window.easyRead TextBox">
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
  </Application.Styles>
</Application>

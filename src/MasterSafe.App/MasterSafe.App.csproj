<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(MasterSafeWindowsTarget)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MasterSafe.App</RootNamespace>
    <AssemblyName>MasterSafe.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
<ItemGroup>
    <ProjectReference Include="..\MasterSafe.Core\MasterSafe.Core.csproj" />
    <ProjectReference Include="..\MasterSafe.Crypto\MasterSafe.Crypto.csproj" />
    <ProjectReference Include="..\MasterSafe.QR\MasterSafe.QR.csproj" />
    <ProjectReference Include="..\MasterSafe.Backup\MasterSafe.Backup.csproj" />
    <ProjectReference Include="..\MasterSafe.Platform\MasterSafe.Platform.csproj" />
  </ItemGroup>
</Project>

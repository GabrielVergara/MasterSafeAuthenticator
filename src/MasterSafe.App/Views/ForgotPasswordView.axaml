<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel">
  <StackPanel Spacing="14">
    <StackPanel Spacing="4">
      <TextBlock Text="Forgot your master password?" Classes="h1" />
      <TextBlock TextWrapping="Wrap" Classes="hint"
                 Text="Your vault is encrypted with your master password, so nobody, including this app, can open it without it. Your old vault is never deleted. Here is what you can do." />
    </StackPanel>

    <Border Classes="card" IsVisible="{Binding IsAvailable}">
      <StackPanel Spacing="10">
        <TextBlock Text="I have a recovery backup and key" Classes="h2" />
        <Button Content="Restore from a recovery backup..." HorizontalAlignment="Left"
                Command="{Binding ToggleRestoreCommand}" IsVisible="{Binding !ShowRestore}" />
        <StackPanel Spacing="10" IsVisible="{Binding ShowRestore}">
          <StackPanel>
            <TextBlock Text="Recovery backup file" Classes="label" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding BackupFilePath, Mode=TwoWay}" PlaceholderText="recovery-....sauth" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..." Command="{Binding BrowseBackupCommand}" />
            </Grid>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Recovery key file" Classes="label" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding KeyFilePath, Mode=TwoWay}" PlaceholderText="MasterSafe-recovery-key-....msrk" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..." Command="{Binding BrowseKeyCommand}" />
            </Grid>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Passphrase of the recovery key" Classes="label" />
            <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding KeyPassphrase, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="New master password" Classes="label" />
            <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding NewPassword, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Confirm new master password" Classes="label" />
            <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding ConfirmPassword, Mode=TwoWay}" />
          </StackPanel>
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="Your old vault is moved to the archive and a new vault is created from the backup, protected by the new password." />
          <Button Classes="accent" Content="Restore my data" HorizontalAlignment="Left"
                  Command="{Binding RestoreCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsAvailable}">
      <StackPanel Spacing="10">
        <TextBlock Text="Start over with a new vault" Classes="h2" />
        <TextBlock TextWrapping="Wrap" Classes="hint"
                   Text="Moves your old vault into the archive and creates an empty new one. You will have to set up your accounts again. If you find your old password later, open the archived vault from the Vaults page." />
        <Button Content="Start a new vault..." HorizontalAlignment="Left"
                Command="{Binding RequestStartNewCommand}" IsVisible="{Binding !ConfirmingNew}" />
        <StackPanel Spacing="8" IsVisible="{Binding ConfirmingNew}">
          <TextBlock Classes="error" Text="Your old vault is kept, but you will not be able to open it without its password. Continue?" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="danger" Content="Yes, start a new vault" Command="{Binding StartNewCommand}" />
            <Button Content="Cancel" Command="{Binding CancelStartNewCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsAvailable}">
      <StackPanel Spacing="10">
        <TextBlock Text="I have another vault file" Classes="h2" />
        <Button Content="Open a vault file..." HorizontalAlignment="Left" Command="{Binding OpenVaultFileCommand}" />
      </StackPanel>
    </Border>

    <TextBlock AutomationProperties.LiveSetting="Polite" Classes="error" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Button Content="Back to sign in" HorizontalAlignment="Left" Command="{Binding CloseCommand}" />
  </StackPanel>
</UserControl>

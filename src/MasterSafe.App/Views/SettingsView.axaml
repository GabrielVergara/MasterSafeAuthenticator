<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="18" MaxWidth="520" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Classes="h1" />

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="General" Classes="h2" />
          <StackPanel>
            <TextBlock Text="Theme" Classes="label" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
          </StackPanel>
          <CheckBox Content="Keep running in the system tray when the window is closed or minimized"
                    IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
          <StackPanel>
            <TextBlock Text="Lock the vault after (minutes of inactivity)" Classes="label" />
            <NumericUpDown Minimum="1" Maximum="120" HorizontalAlignment="Left" Width="160"
                           Value="{Binding AutoLockMinutes, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Clear the clipboard after copying a password or code" Classes="label" />
            <ComboBox HorizontalAlignment="Left" Width="200" ItemsSource="{Binding ClipboardDelays}"
                      SelectedItem="{Binding SelectedClipboardDelay, Mode=TwoWay}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Counted from the last copy: copying another secret starts the wait again. Anything else you copy yourself is left alone." />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Privacy and locking" Classes="h2" />
          <CheckBox Content="Lock the vault when Windows is locked or the computer goes to sleep"
                    IsChecked="{Binding LockOnSessionLock, Mode=TwoWay}" />
          <CheckBox Content="Lock the vault when the window is minimized"
                    IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
          <CheckBox Content="Keep this window out of screenshots and screen sharing (Windows)"
                    IsChecked="{Binding BlockScreenCapture, Mode=TwoWay}" />
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="Screenshots and screen sharing show this window as black while this is on. Turn it off if you need to capture the window." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Unlock methods" Classes="h2" />
          <TextBlock Classes="hint"
                     Text="Besides your master password you can unlock with Windows Hello or a FIDO2 security key. The master password always keeps working." />
          <ItemsControl ItemsSource="{Binding UnlockMethods}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UnlockMethodRowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Added}" Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="danger" Content="Remove" IsVisible="{Binding CanRemove}"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveMethodCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding AddableMethods}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AddMethodOptionViewModel">
                <Button Content="{Binding Text}" HorizontalAlignment="Left" Margin="0,0,0,6"
                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).AddMethodCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding UnlockMethodStatus}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Change master password" Classes="h2" />
          <TextBlock Classes="hint" Text="The new password protects your vault key from now on. Windows Hello keeps working. Choose a long passphrase you will remember." />
          <StackPanel>
            <TextBlock Text="Current password" Classes="label" />
            <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding CurrentPassword, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="New password" Classes="label" />
            <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding NewPassword, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Confirm new password" Classes="label" />
            <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding ConfirmNewPassword, Mode=TwoWay}" />
          </StackPanel>
          <Button Classes="accent" Content="Change password" HorizontalAlignment="Left"
                  Command="{Binding ChangePasswordCommand}" />
          <TextBlock Text="{Binding PasswordChangeStatus}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             xmlns:core="clr-namespace:MasterSafe.Core;assembly=MasterSafe.Core"
             xmlns:svc="clr-namespace:MasterSafe.App.Services"
             x:Class="MasterSafe.App.Views.PasswordsView"
             x:DataType="vm:PasswordsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card.current">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Grid x:Name="MainGrid" RowDefinitions="Auto,*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" MinWidth="150" MaxWidth="450" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,16" Spacing="2">
      <TextBlock Text="Passwords" Classes="h1" />
      <TextBlock Classes="hint" Text="Logins stored in your encrypted vault. Copied values are cleared from the clipboard automatically (you can change the time in Settings)." />
    </StackPanel>

    <!-- Folders -->
    <Border Grid.Row="1" Grid.Column="0" Classes="card" Padding="10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
          <TextBlock Text="Name for a new folder, or the new name" Classes="label" TextWrapping="Wrap" />
          <TextBox x:Name="FolderNameBox" PlaceholderText="Type a name" Text="{Binding FolderName, Mode=TwoWay}" ToolTip.Tip="Type a name, then choose New folder, or Rename selected" />
          <Button Content="New folder" Command="{Binding CreateFolderCommand}"
                  ToolTip.Tip="Creates the folder inside the selected one" />
          <Button Content="Rename selected" Command="{Binding RenameFolderCommand}" IsVisible="{Binding HasFolderSelected}" />
          <Button x:Name="ChangeIconButton" Content="Change icon..." IsVisible="{Binding HasFolderSelected}">
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedTop">
                <StackPanel Spacing="8" Width="290">
                  <TextBlock Text="Pick an icon for this folder" Classes="label" />
                  <ItemsControl ItemsSource="{Binding IconChoices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="svc:FolderIcon">
                        <Button Margin="0,0,6,6" Padding="8" ToolTip.Tip="{Binding Name}" Click="OnIconPicked"
                                Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).SetFolderIconCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="{Binding Geometry}" Fill="{DynamicResource CodeBrush}" Width="22" Height="22" Stretch="Uniform" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Classes="danger" Content="Delete folder" Command="{Binding DeleteFolderCommand}" IsVisible="{Binding HasFolderSelected}"
                  ToolTip.Tip="The passwords in it are kept and move up one level" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Folders" Classes="h2" Margin="0,0,0,8" />
        <ListBox x:Name="FolderList" ToolTip.Tip="Folders" ItemsSource="{Binding FolderNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FolderNode">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}" Background="Transparent">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="New folder here..." Click="OnFolderMenuNew" />
                    <MenuItem Header="Rename..." Click="OnFolderMenuRename" />
                    <MenuItem Header="Change icon..." Click="OnFolderMenuIcon" />
                    <MenuItem Header="Delete folder" Click="OnFolderMenuDelete" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <Path Data="{Binding Icon}" Fill="{DynamicResource CodeBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Drag to change the width of the folder list; double-click to fit it to the folder names again -->
    <GridSplitter x:Name="FolderSplitter" Grid.Row="1" Grid.Column="1" Width="14" Background="Transparent"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast"
                  ToolTip.Tip="Drag to resize the folder list. Double-click to fit it to the folder names." />

    <!-- List -->
    <DockPanel x:Name="ListPanel" Grid.Row="1" Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <TextBlock Text="Search" Classes="label" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="SearchBox" PlaceholderText="Title, user name, URL, folder or tag (Ctrl+F)" Text="{Binding SearchText, Mode=TwoWay}" />
          <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="170" ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSort, Mode=TwoWay}" ToolTip.Tip="Order of the list" />
        </Grid>
      </StackPanel>
      <TextBlock AutomationProperties.LiveSetting="Polite" DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding Status}" Classes="hint" />

      <Border DockPanel.Dock="Top" Classes="card" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,0,10"
              IsVisible="{Binding HasPendingDelete}">
        <StackPanel Spacing="8">
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding DeleteQuestion}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="danger" Content="{Binding DeleteConfirmText}" Command="{Binding ConfirmDeleteCommand}" />
            <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" Classes="card" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,0,10"
              IsVisible="{Binding IsConfirmingBulkDelete}">
        <StackPanel Spacing="8">
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding BulkDeleteQuestion}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="danger" Content="Yes, do it" Command="{Binding ConfirmDeleteSelectedCommand}" />
            <Button Content="Keep them" Command="{Binding CancelDeleteSelectedCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" IsVisible="{Binding IsInBin}">
        <StackPanel Spacing="8">
          <TextBlock Text="Recycle bin" Classes="h2" />
          <TextBlock Classes="hint" TextWrapping="Wrap"
                     Text="Deleted passwords stay here for 30 days, with their attached files, and can be restored. After that they are removed for good." />
          <Button Classes="danger" Content="Empty the recycle bin" HorizontalAlignment="Left" Command="{Binding RequestEmptyBinCommand}" />
          <StackPanel Spacing="8" IsVisible="{Binding IsConfirmingEmptyBin}">
            <TextBlock Classes="error" TextWrapping="Wrap" Text="Delete everything in the recycle bin for good? This cannot be undone." />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="danger" Content="Yes, empty it" Command="{Binding ConfirmEmptyBinCommand}" />
              <Button Content="Keep them" Command="{Binding CancelEmptyBinCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2" IsVisible="{Binding !IsEmpty}">
        <Button Content="Select all shown" Command="{Binding SelectAllCommand}" Margin="0,0,8,8" />
        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" IsVisible="{Binding HasSelection}" Margin="0,0,8,8" />
        <Button Classes="danger" Command="{Binding RequestDeleteSelectedCommand}" IsVisible="{Binding HasSelection}" Margin="0,0,8,8">
          <TextBlock>
            <Run Text="Delete selected (" /><Run Text="{Binding SelectedCount}" /><Run Text=")" />
          </TextBlock>
        </Button>
      </WrapPanel>

      <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2" IsVisible="{Binding HasSelection}">
        <TextBlock Text="Move selected to" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding MoveTarget, Mode=TwoWay}" MinWidth="170"
                  PlaceholderText="Choose a folder" Margin="0,0,8,8">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FolderChoice">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{Binding Icon}" Fill="{DynamicResource CodeBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Move" Command="{Binding MoveSelectedCommand}" Margin="0,0,0,8" />
      </WrapPanel>

      <Border DockPanel.Dock="Top" Classes="card" IsVisible="{Binding IsEmpty}" Padding="24">
        <StackPanel Spacing="6">
          <TextBlock Text="No passwords to show" Classes="h2" />
          <TextBlock Classes="hint" Text="Fill in the form on the right and choose Save to add your first entry." />
        </StackPanel>
      </Border>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PasswordRow">
              <Border Classes="card" Margin="0,0,0,10" Padding="14" Classes.current="{Binding IsCurrent}"
                      Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                      PointerPressed="OnCardPointerPressed" PointerMoved="OnCardPointerMoved" PointerReleased="OnCardPointerReleased">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy password" Click="OnMenuCopyPassword" IsVisible="{Binding IsActive}" />
                    <MenuItem Header="Copy user name" Click="OnMenuCopyUser" IsVisible="{Binding IsActive}" />
                    <MenuItem Header="Open site" Click="OnMenuOpenSite" IsVisible="{Binding IsActive}" />
                    <MenuItem Header="Edit" Click="OnMenuEdit" IsVisible="{Binding IsActive}" />
                    <MenuItem Header="Restore" Click="OnMenuRestore" IsVisible="{Binding IsDeleted}" />
                    <MenuItem Header="Delete" Click="OnMenuDelete" />
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Entry.Title, StringFormat='Select {0}'}" VerticalAlignment="Top" ToolTip.Tip="Select for deleting several at once" />
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Entry.Title}" Classes="h2" />
                      <TextBlock Text="{Binding Entry.UserName}" Classes="hint" />
                      <TextBlock Text="{Binding Entry.Url}" Classes="hint" />
                      <TextBlock Text="{Binding Entry.Folder, StringFormat='Folder: {0}'}" Classes="hint" IsVisible="{Binding Entry.Folder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasAttachments}">
                        <Path Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z" Fill="{DynamicResource CodeBrush}" Width="14" Height="14" Stretch="Uniform" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AttachmentsText}" Classes="hint" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <WrapPanel IsVisible="{Binding IsDeleted}">
                    <WrapPanel.Styles>
                      <Style Selector="WrapPanel > Button">
                        <Setter Property="Margin" Value="0,0,6,6" />
                      </Style>
                    </WrapPanel.Styles>
                    <Button Classes="accent" Content="Restore" CommandParameter="{Binding Entry}"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).RestoreCommand}" />
                    <Button Classes="danger" Content="Delete for good" CommandParameter="{Binding Entry}"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).RequestDeleteCommand}" />
                  </WrapPanel>
                  <WrapPanel IsVisible="{Binding IsActive}">
                    <WrapPanel.Styles>
                      <Style Selector="WrapPanel > Button">
                        <Setter Property="Margin" Value="0,0,6,6" />
                      </Style>
                    </WrapPanel.Styles>
                    <Button Content="Copy user"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).CopyUserNameCommand}"
                            CommandParameter="{Binding Entry}" />
                    <Button Classes="accent" Content="Copy password"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).CopyPasswordCommand}"
                            CommandParameter="{Binding Entry}" />
                    <Button Content="Open site" IsVisible="{Binding Entry.Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).OpenUrlCommand}"
                            CommandParameter="{Binding Entry}" />
                    <Button Content="Edit"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding Entry}" />
                    <Button Classes="danger" Content="Delete"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).RequestDeleteCommand}"
                            CommandParameter="{Binding Entry}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Entry form -->
    <Border x:Name="EntryForm" Grid.Row="1" Grid.Column="3" Classes="card" Margin="2,0,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
          <Button Content="Clear form" Command="{Binding ClearFormCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Entry" Classes="h2" Margin="0,0,0,10" />
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Title" Classes="label" />
              <TextBox x:Name="TitleBox" Text="{Binding Title, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="User name" Classes="label" />
              <TextBox Text="{Binding UserName, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Password" Classes="label" />
              <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding Password, Mode=TwoWay}" />
              <ProgressBar ToolTip.Tip="Password strength" Minimum="0" Maximum="4" Value="{Binding StrengthScore}" Height="6" Margin="0,8,0,0"
                           IsVisible="{Binding StrengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding StrengthText}"
                         IsVisible="{Binding StrengthText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Content="Generate strong password" Margin="0,8,0,0" Command="{Binding GenerateCommand}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Website address (URL)" Classes="label" />
              <TextBox PlaceholderText="https://" Text="{Binding Url, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Folder" Classes="label" />
              <ComboBox ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding FormFolder, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FolderChoice">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="{Binding Icon}" Fill="{DynamicResource CodeBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Tags (comma separated)" Classes="label" />
              <TextBox Text="{Binding Tags, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Notes" Classes="label" />
              <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="80" Text="{Binding Notes, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding HasHistory}">
              <TextBlock Text="Earlier versions" Classes="label" />
              <ItemsControl ItemsSource="{Binding FormHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRow">
                    <StackPanel Margin="0,0,0,6" Spacing="4">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="hint" />
                      <WrapPanel>
                        <Button Content="Use this version" Margin="0,0,6,0" CommandParameter="{Binding}"
                                Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).UseVersionCommand}" />
                        <Button Content="Copy its password" CommandParameter="{Binding}"
                                Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).CopyVersionPasswordCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Attached files" Classes="label" />
              <ItemsControl ItemsSource="{Binding FormAttachments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AttachmentRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SizeText}" Classes="hint" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Save as..." CommandParameter="{Binding}"
                                Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).SaveAttachmentCommand}" />
                        <Button Classes="danger" Content="Remove" CommandParameter="{Binding}"
                                Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).RemoveAttachmentCommand}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Attach a file..." HorizontalAlignment="Left" Command="{Binding AddAttachmentCommand}" />
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="Up to 5 MB per file. A copy you save out is no longer protected by your vault." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>

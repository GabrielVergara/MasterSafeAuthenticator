<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             xmlns:conv="clr-namespace:MasterSafe.App.Converters"
             x:Class="MasterSafe.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
      <StackPanel Spacing="2">
        <TextBlock Text="Encrypted backups" Classes="h1" />
        <TextBlock Classes="hint" Text="Backups are encrypted with your master password before they leave this computer (.sauth files)." />
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Destination" Classes="label" />
        <ComboBox ItemsSource="{Binding Providers}"
                  SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BackupProviderKind">
              <TextBlock Text="{Binding Converter={x:Static conv:BackupProviderKindConverter.Instance}}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Local folder -->
      <StackPanel IsVisible="{Binding IsLocal}">
        <TextBlock Text="Backup folder" Classes="label" />
        <TextBox PlaceholderText="e.g. D:\Backups\MasterSafe" Text="{Binding Folder, Mode=TwoWay}" />
      </StackPanel>

      <!-- WebDAV (Nextcloud, ownCloud, others) -->
      <StackPanel Spacing="12" IsVisible="{Binding IsWebDav}">
        <StackPanel>
          <TextBlock Text="WebDAV folder address" Classes="label" />
          <TextBox PlaceholderText="https://cloud.example.com/remote.php/dav/files/you/backups/"
                   Text="{Binding WebDavUrl, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="WebDAV user name" Classes="label" />
          <TextBox Text="{Binding WebDavUser, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="WebDAV password or app password" Classes="label" />
          <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding WebDavPassword, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Master password (encrypts the backup)" Classes="label" />
        <TextBox Classes="revealPasswordButton" PasswordChar="●" Text="{Binding MasterPassword, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Export backup" Command="{Binding ExportCommand}" />
        <Button Content="Refresh list" Command="{Binding RefreshCommand}" />
        <Button Content="Import selected" Command="{Binding ImportCommand}" />
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Existing backups" Classes="label" />
        <ListBox ItemsSource="{Binding Backups}"
                 SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                 Height="160" />
      </StackPanel>

      <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" Classes="hint" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

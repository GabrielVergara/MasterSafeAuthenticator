<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             xmlns:help="clr-namespace:MasterSafe.App.Help"
             x:Class="MasterSafe.App.Views.HelpView"
             x:DataType="vm:HelpViewModel">
  <Grid ColumnDefinitions="280,*" RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
               Text="Help" Classes="h1" Margin="0,0,0,12" />

    <DockPanel Grid.Row="1" Grid.Column="0">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBox PlaceholderText="Search the help" Text="{Binding SearchText, Mode=TwoWay}" />
      <TextBlock Text="Nothing matches your search." Classes="hint" Margin="0,6,0,0" IsVisible="{Binding HasNoResults}" />
    </StackPanel>
    <ListBox ToolTip.Tip="Help topics"
             ItemsSource="{Binding Topics}"
             SelectedItem="{Binding SelectedTopic, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="help:HelpTopic">
          <StackPanel Spacing="2" Margin="0,4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </DockPanel>

    <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
      <StackPanel Spacing="10" DataContext="{Binding SelectedTopic}"
                  x:DataType="help:HelpTopic">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="21" MaxWidth="720" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

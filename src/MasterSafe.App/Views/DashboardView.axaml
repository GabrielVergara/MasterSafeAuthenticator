<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding StatusMessage}" Opacity="0.7" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Accounts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OtpItemViewModel">
            <Border Margin="0,0,0,8" Padding="16" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding Issuer}" FontWeight="SemiBold" FontSize="16" />
                  <TextBlock Text="{Binding Label}" Opacity="0.7" />
                  <TextBlock Text="{Binding DisplayCode}" FontSize="24" FontFamily="monospace" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="12,0">
                  <ProgressBar Width="48" Height="48"
                               Minimum="0" Maximum="1"
                               Value="{Binding Progress}" />
                  <TextBlock Text="{Binding SecondsRemaining}" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Content="Copy" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyCodeCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="3" Content="Delete" VerticalAlignment="Center" Margin="8,0,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).DeleteCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>

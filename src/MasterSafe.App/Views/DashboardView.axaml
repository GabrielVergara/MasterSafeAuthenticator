<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Spacing="2">
      <TextBlock Text="Authenticator codes" Classes="h1" />
      <TextBlock Text="Codes refresh automatically. Copy one and paste it into the website or app asking for it."
                 Classes="hint" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding StatusMessage}" Classes="hint" />

    <!-- Reminders -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Notices}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:NoticeRow">
          <Border Classes="card" Margin="0,0,0,10" Padding="14">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Margin="12,0,0,0" Classes="accent" Content="{Binding ActionText}" Command="{Binding Action}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="Not now" CommandParameter="{Binding}"
                      Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).DismissNoticeCommand}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Search and order (only when there are enough accounts to need it) -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding ShowSearch}">
      <TextBox PlaceholderText="Search by issuer or name" Text="{Binding SearchText, Mode=TwoWay}" />
      <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="170" ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort, Mode=TwoWay}" ToolTip.Tip="Order of the list" />
    </Grid>

    <!-- Rename an account -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" IsVisible="{Binding IsEditing}">
      <StackPanel Spacing="8">
        <TextBlock Text="Rename account" Classes="h2" />
        <TextBlock Classes="hint" Text="This only changes the names shown here. The secret and the codes stay the same." />
        <StackPanel>
          <TextBlock Text="Issuer (for example GitHub)" Classes="label" />
          <TextBox Text="{Binding EditIssuer, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Label (for example your user name)" Classes="label" />
          <TextBox Text="{Binding EditLabel, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="Save" Command="{Binding SaveEditCommand}" />
          <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10" IsVisible="{Binding HasNoMatches}">
      <TextBlock Classes="hint" Text="No account matches your search." />
    </Border>

    <!-- Confirm before deleting an account -->
    <Border DockPanel.Dock="Top" Classes="card" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,0,10"
            IsVisible="{Binding HasPendingDelete}">
      <StackPanel Spacing="8">
        <TextBlock Classes="error">
          <Run Text="Delete " /><Run Text="{Binding PendingDelete.Issuer}" FontWeight="SemiBold" /><Run Text="? You may lose access to that account if you cannot sign in to it another way." />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="danger" Content="Yes, delete it" Command="{Binding ConfirmDeleteCommand}" />
          <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Empty state -->
    <Border DockPanel.Dock="Top" Classes="card" IsVisible="{Binding IsEmpty}" Padding="28">
      <StackPanel Spacing="6">
        <TextBlock Text="No accounts yet" Classes="h2" />
        <TextBlock Classes="hint"
                   Text="Use Add account to type a secret key, or Import to read an otpauth link or a QR code image." />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Shown}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OtpItemViewModel">
            <Border Classes="card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding Issuer}" Classes="h2" />
                  <TextBlock Text="{Binding Label}" Classes="hint" />
                  <TextBlock Text="{Binding DisplayCode}" Classes="code" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="16,0" Width="72">
                  <TextBlock Text="{Binding SecondsRemaining, StringFormat='{}{0} s'}"
                             HorizontalAlignment="Center" Classes="hint" />
                  <ProgressBar Minimum="0" Maximum="1" MinWidth="0" Width="72" Height="4" Value="{Binding Progress}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="accent" Content="Copy code"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyCodeCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="Rename"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).BeginEditCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="danger" Content="Delete"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).RequestDeleteCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>

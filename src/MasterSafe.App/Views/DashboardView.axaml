<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Spacing="2">
      <TextBlock Text="Authenticator codes" Classes="h1" />
      <TextBlock Text="Codes refresh automatically. Copy one and paste it into the website or app asking for it."
                 Classes="hint" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding StatusMessage}" Classes="hint" />

    <!-- Empty state -->
    <Border DockPanel.Dock="Top" Classes="card" IsVisible="{Binding IsEmpty}" Padding="28">
      <StackPanel Spacing="6">
        <TextBlock Text="No accounts yet" Classes="h2" />
        <TextBlock Classes="hint"
                   Text="Use Add account to type a secret key, or Import to read an otpauth link or a QR code image." />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Accounts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OtpItemViewModel">
            <Border Classes="card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding Issuer}" Classes="h2" />
                  <TextBlock Text="{Binding Label}" Classes="hint" />
                  <TextBlock Text="{Binding DisplayCode}" Classes="code" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="16,0" Width="72">
                  <TextBlock Text="{Binding SecondsRemaining, StringFormat='{}{0} s'}"
                             HorizontalAlignment="Center" Classes="hint" />
                  <ProgressBar Minimum="0" Maximum="1" MinWidth="0" Width="72" Height="4" Value="{Binding Progress}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="accent" Content="Copy code"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).CopyCodeCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="danger" Content="Delete"
                          Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>

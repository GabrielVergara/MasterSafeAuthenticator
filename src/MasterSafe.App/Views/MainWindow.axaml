<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
        x:Class="MasterSafe.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="680"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Title="MasterSafe Authenticator">
  <Grid ColumnDefinitions="Auto,*">

    <!-- Sidebar: only shown while the vault is unlocked -->
    <Border Grid.Column="0" Width="224" Background="#12263A" IsVisible="{Binding IsUnlocked}">
      <DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,20">
          <Image Source="/Assets/logo-256.png" Width="36" Height="36" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MasterSafe" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Authenticator" Foreground="#8FA6B8" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Button Classes="nav" Content="About" Command="{Binding ShowAboutCommand}" />
          <Button Classes="nav" Content="Lock vault" Command="{Binding LockCommand}"
                  ToolTip.Tip="Lock the vault and require your master password again" />
        </StackPanel>

        <StackPanel Spacing="2">
          <Button Classes="nav" Content="Authenticator codes" Command="{Binding ShowDashboardCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Dashboard}" />
          <Button Classes="nav" Content="Passwords" Command="{Binding ShowPasswordsCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Passwords}" />
          <Button Classes="nav" Content="Password health" Command="{Binding ShowHealthCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Health}" />
          <Button Classes="nav" Content="Add account" Command="{Binding ShowAddAccountCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Add}" />
          <Button Classes="nav" Content="Import" Command="{Binding ShowImportCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Import}" />
          <Button Classes="nav" Content="Backup" Command="{Binding ShowBackupCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Backup}" />
          <Button Classes="nav" Content="Recovery" Command="{Binding ShowRecoveryCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Recovery}" />
          <Button Classes="nav" Content="Vaults" Command="{Binding ShowVaultsCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Vaults}" />
          <Button Classes="nav" Content="Settings" Command="{Binding ShowSettingsCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Settings}" />
          <Button Classes="nav" Content="Help" Command="{Binding ShowHelpCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Help}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Page content -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,24" />
  </Grid>
</Window>

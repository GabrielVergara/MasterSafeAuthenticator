<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
        x:Class="MasterSafe.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="760"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Classes.easyRead="{Binding Settings.EasyReading}"
        Title="MasterSafe Authenticator">
  <Window.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding HelpShortcutCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding LockShortcutCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ZoomResetCommand}" />
  </Window.KeyBindings>
  <LayoutTransformControl x:Name="ZoomHost">
  <LayoutTransformControl.LayoutTransform>
    <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}" />
  </LayoutTransformControl.LayoutTransform>
  <Grid ColumnDefinitions="Auto,*">

    <!-- Sidebar: only shown while the vault is unlocked -->
    <Border Grid.Column="0" Width="224" Background="#12263A" IsVisible="{Binding IsUnlocked}" AutomationProperties.LandmarkType="Navigation">
      <DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,20">
          <Image Source="/Assets/logo-256.png" Width="36" Height="36" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MasterSafe" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Authenticator" Foreground="#8FA6B8" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Button Classes="nav" Content="Abou_t" Command="{Binding ShowAboutCommand}" />
          <Button Classes="nav" Content="_Lock vault" Command="{Binding LockCommand}"
                  ToolTip.Tip="Lock the vault and require your master password again" />
          <Button Classes="nav" Content="E_xit" Command="{Binding ExitCommand}"
                  ToolTip.Tip="Lock the vault and close MasterSafe completely" />
        </StackPanel>

        <StackPanel Spacing="2">
          <Button Classes="nav" Content="Authenticator c_odes" Command="{Binding ShowDashboardCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Dashboard}" />
          <Button Classes="nav" Content="_Passwords" Command="{Binding ShowPasswordsCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Passwords}" />
          <Button Classes="nav" Content="Password _health" Command="{Binding ShowHealthCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Health}" />
          <Button Classes="nav" Content="_Add account" Command="{Binding ShowAddAccountCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Add}" />
          <Button Classes="nav" Content="_Import" Command="{Binding ShowImportCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Import}" />
          <Button Classes="nav" Content="_Backup" Command="{Binding ShowBackupCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Backup}" />
          <Button Classes="nav" Content="_Recovery" Command="{Binding ShowRecoveryCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Recovery}" />
          <Button Classes="nav" Content="_Vaults" Command="{Binding ShowVaultsCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Vaults}" />
          <Button Classes="nav" Content="_Settings" Command="{Binding ShowSettingsCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Settings}" />
          <Button Classes="nav" Content="Help (F1)" Command="{Binding ShowHelpCommand}"
                  Classes.active="{Binding ActiveSection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Help}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Page content -->
    <DockPanel Grid.Column="1" Margin="28,24" AutomationProperties.LandmarkType="Main">
      <Border DockPanel.Dock="Top" Classes="card" BorderBrush="{DynamicResource DangerBrush}" Margin="0,0,0,12"
              IsVisible="{Binding IsLockWarningVisible}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding LockWarningText}" TextWrapping="Wrap" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Assertive" />
          <Button Grid.Column="1" Margin="12,0,0,0" Classes="accent" Content="Keep unlocked" Command="{Binding KeepUnlockedCommand}" />
        </Grid>
      </Border>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
  </Grid>
  </LayoutTransformControl>
</Window>

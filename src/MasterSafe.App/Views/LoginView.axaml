<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:MasterSafe.App.Views"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <ScrollViewer VerticalAlignment="Center" HorizontalAlignment="Center" VerticalScrollBarVisibility="Auto">
  <Border Classes="card" Width="440" Margin="16" Padding="28">
    <Grid>
    <ContentControl Content="{Binding Forgot}" IsVisible="{Binding Forgot.IsOpen}" />
    <StackPanel Spacing="14" IsVisible="{Binding !Forgot.IsOpen}">
      <Image Source="/Assets/logo-256.png" Width="72" Height="72" HorizontalAlignment="Center" />
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" Classes="h1" HorizontalAlignment="Center" />
        <TextBlock Text="MasterSafe Authenticator" Classes="hint" HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Master password" Classes="label" />
        <v:SecretTextBox x:Name="PasswordBox" Classes="revealPasswordButton"
                 Text="{Binding MasterPassword, Mode=TwoWay}">
          <v:SecretTextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
          </v:SecretTextBox.KeyBindings>
        </v:SecretTextBox>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsCreateMode}">
        <TextBlock Text="Confirm master password" Classes="label" />
        <v:SecretTextBox Classes="revealPasswordButton"
                 Text="{Binding ConfirmPassword, Mode=TwoWay}">
          <v:SecretTextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
          </v:SecretTextBox.KeyBindings>
        </v:SecretTextBox>
        <TextBlock Classes="hint" Margin="0,8,0,0" Text="{Binding PasswordHint}" />
        <TextBlock Classes="hint" Text="It cannot be recovered if you forget it. After signing in you can set up a recovery key." />
      </StackPanel>

      <TextBlock AutomationProperties.LiveSetting="Polite" Classes="error" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="card" BorderBrush="{DynamicResource DangerBrush}" Padding="12"
              IsVisible="{Binding IsLockedOut}">
        <TextBlock AutomationProperties.LiveSetting="Polite" Classes="error" TextWrapping="Wrap" Text="{Binding LockoutMessage}" />
      </Border>

      <Button Classes="accent" Content="{Binding ButtonText}" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Command="{Binding UnlockCommand}" />
      <ItemsControl ItemsSource="{Binding UnlockMethods}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UnlockMethodViewModel">
            <Button Content="{Binding Text}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,0,0,8"
                    Command="{Binding $parent[ItemsControl].((vm:LoginViewModel)DataContext).UnlockWithMethodCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="I already have a vault file..." HorizontalAlignment="Center" IsVisible="{Binding IsCreateMode}"
              Command="{Binding Forgot.OpenVaultFileCommand}" />
      <Button Content="Forgot your master password?" HorizontalAlignment="Center" IsVisible="{Binding !IsCreateMode}"
              Command="{Binding ShowForgotCommand}" />
    </StackPanel>
    </Grid>
  </Border>
  </ScrollViewer>
</UserControl>

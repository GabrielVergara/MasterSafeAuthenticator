<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
    <StackPanel Spacing="2">
      <TextBlock Text="Import account" Classes="h1" />
      <TextBlock Classes="hint" Text="Add an account from the link behind its QR code, or drop a QR image onto this window." />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Setup link (otpauth://)" Classes="label" />
      <TextBox PlaceholderText="otpauth://totp/Example:name@example.com?secret=..." Text="{Binding ManualUri, Mode=TwoWay}" />
    </StackPanel>
    <Button Classes="accent" Content="Import" HorizontalAlignment="Left" Command="{Binding ImportUriCommand}" />
    <Border Classes="card" Padding="20">
      <StackPanel Spacing="10">
        <TextBlock Text="From a QR code image" Classes="h2" />
        <TextBlock TextWrapping="Wrap" Classes="hint"
                   Text="Drag a PNG, JPG or BMP picture of the QR code onto this window, or choose the file yourself. You can drop several images at once." />
        <Button Content="Choose an image..." HorizontalAlignment="Left" Command="{Binding BrowseImageCommand}" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

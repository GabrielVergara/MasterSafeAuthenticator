<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
    <StackPanel Spacing="2">
      <TextBlock Text="Import" Classes="h1" />
      <TextBlock Classes="hint" Text="Add authenticator accounts from a link or a QR code image, or move your passwords over from KeePass." />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Setup link (otpauth://)" Classes="label" />
      <TextBox PlaceholderText="otpauth://totp/Example:name@example.com?secret=..." Text="{Binding ManualUri, Mode=TwoWay}" />
    </StackPanel>
    <Button Classes="accent" Content="Import" HorizontalAlignment="Left" Command="{Binding ImportUriCommand}" />
    <Border Classes="card" Padding="20">
      <StackPanel Spacing="10">
        <TextBlock Text="From a QR code image" Classes="h2" />
        <TextBlock TextWrapping="Wrap" Classes="hint"
                   Text="Drag a PNG, JPG or BMP picture of the QR code onto this window, or choose the file yourself. You can drop several images at once." />
        <Button Content="Choose an image..." HorizontalAlignment="Left" Command="{Binding BrowseImageCommand}" />
      </StackPanel>
    </Border>
    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" TextWrapping="Wrap" />
    <Border Classes="card" Padding="20" DataContext="{Binding KeePass}" x:DataType="vm:KeePassImportViewModel">
      <StackPanel Spacing="10">
        <TextBlock Text="From KeePass or KeePassXC" Classes="h2" />
        <TextBlock TextWrapping="Wrap" Classes="hint"
                   Text="Export your database from KeePass (File, Export, KeePass XML) or KeePassXC (Database, Export to CSV or XML), then choose the file here. You see a summary first and nothing is added until you confirm." />
        <TextBlock TextWrapping="Wrap" Classes="hint"
                   Text="The export file is not encrypted. Delete it as soon as you have imported it." />
        <Button Content="Choose an export file..." HorizontalAlignment="Left" Command="{Binding ChooseFileCommand}" />
        <StackPanel Spacing="8" IsVisible="{Binding HasPreview}">
          <ItemsControl ItemsSource="{Binding Preview}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="Import" Command="{Binding ConfirmCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Show file" Command="{Binding ShowFileCommand}" />
          </StackPanel>
        </StackPanel>
        <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

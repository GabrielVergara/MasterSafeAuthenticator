<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
    <StackPanel Spacing="2">
      <TextBlock Text="Import account" Classes="h1" />
      <TextBlock Classes="hint" Text="Add an account from the link behind its QR code, or drop a QR image onto this window." />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Setup link (otpauth://)" Classes="label" />
      <TextBox Watermark="otpauth://totp/Example:name@example.com?secret=..." Text="{Binding ManualUri, Mode=TwoWay}" />
    </StackPanel>
    <Button Classes="accent" Content="Import" HorizontalAlignment="Left" Command="{Binding ImportUriCommand}" />
    <Border Classes="card" Padding="20">
      <TextBlock Text="Drag a QR code image (png, jpg, jpeg or bmp) onto the window to import it." Classes="hint" />
    </Border>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>

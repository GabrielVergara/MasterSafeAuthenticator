<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MasterSafe.App.ViewModels"
             x:Class="MasterSafe.App.Views.AccountEditorView"
             x:DataType="vm:AccountEditorViewModel">
  <StackPanel Spacing="10" MaxWidth="420" HorizontalAlignment="Left">
    <TextBlock Text="Account" FontSize="22" FontWeight="SemiBold" />
    <TextBox Watermark="Issuer" Text="{Binding Issuer, Mode=TwoWay}" />
    <TextBox Watermark="Label" Text="{Binding Label, Mode=TwoWay}" />
    <TextBox Watermark="Secret (Base32)" Text="{Binding Secret, Mode=TwoWay}" />
    <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm, Mode=TwoWay}" />
    <ComboBox ItemsSource="{Binding DigitOptions}" SelectedItem="{Binding Digits, Mode=TwoWay}" />
    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding Period, Mode=TwoWay}" />
    <Button Content="Save account" Command="{Binding SaveCommand}" />
    <TextBlock Text="{Binding ValidationError}" Foreground="IndianRed"
               IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>

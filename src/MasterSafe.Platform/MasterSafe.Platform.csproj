<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MasterSafe.Platform</RootNamespace>
    <AssemblyName>MasterSafe.Platform</AssemblyName>
    <!-- Windows builds target the Windows 10 API set (Windows Hello); other systems use plain net10.0. -->
    <TargetFramework Condition="'$(MasterSafeWindowsTarget)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(MasterSafeWindowsTarget)' == 'true'">
    <!-- Generates the Windows WebAuthn (FIDO2) bindings at build time from Microsoft's metadata. Nothing is shipped. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
    <!-- Tells the app when Windows is locked or goes to sleep, so the vault can lock too. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MasterSafe.Crypto\MasterSafe.Crypto.csproj" />
  </ItemGroup>
</Project>

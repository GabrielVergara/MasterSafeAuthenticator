<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeAuthenticator.App.ViewModels"
             x:Class="SafeAuthenticator.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Theme" />
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
      <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
      <TextBlock Text="Auto-lock after (minutes)" />
      <NumericUpDown Minimum="1" Maximum="120" Value="{Binding AutoLockMinutes, Mode=TwoWay}" />

      <Separator Margin="0,12" />
      <TextBlock Text="Change master password" FontSize="18" FontWeight="SemiBold" />
      <TextBox Watermark="Current password" PasswordChar="*" Text="{Binding CurrentPassword, Mode=TwoWay}" />
      <TextBox Watermark="New password" PasswordChar="*" Text="{Binding NewPassword, Mode=TwoWay}" />
      <TextBox Watermark="Confirm new password" PasswordChar="*" Text="{Binding ConfirmNewPassword, Mode=TwoWay}" />
      <Button Content="Change password" Command="{Binding ChangePasswordCommand}" />
      <TextBlock Text="{Binding PasswordChangeStatus}" TextWrapping="Wrap" Opacity="0.8" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

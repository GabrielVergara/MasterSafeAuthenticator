<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeAuthenticator.App.ViewModels"
             xmlns:help="clr-namespace:SafeAuthenticator.App.Help"
             x:Class="SafeAuthenticator.App.Views.HelpView"
             x:DataType="vm:HelpViewModel">
  <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
               Text="Help" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

    <ListBox Grid.Row="1" Grid.Column="0"
             ItemsSource="{Binding Topics}"
             SelectedItem="{Binding SelectedTopic, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="help:HelpTopic">
          <StackPanel Spacing="2" Margin="0,4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
      <StackPanel Spacing="10" DataContext="{Binding SelectedTopic}"
                  x:DataType="help:HelpTopic">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeAuthenticator.App.ViewModels"
             x:Class="SafeAuthenticator.App.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
    <TextBlock Text="Import account" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="Paste an otpauth:// URI" />
    <TextBox Watermark="otpauth://totp/..." Text="{Binding ManualUri, Mode=TwoWay}" />
    <Button Content="Import" Command="{Binding ImportUriCommand}" />
    <TextBlock Text="Or drag a QR image (png/jpg/jpeg/bmp) onto the window." Opacity="0.7" />
    <TextBlock Text="{Binding Status}" />
  </StackPanel>
</UserControl>

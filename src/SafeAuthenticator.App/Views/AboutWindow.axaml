<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SafeAuthenticator.App.ViewModels"
        x:Class="SafeAuthenticator.App.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Width="420" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="About SafeAuthenticator">
  <StackPanel Margin="24" Spacing="12" VerticalAlignment="Center">
    <TextBlock Text="{Binding ProductName}" FontSize="26" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Tagline}" TextWrapping="Wrap" Opacity="0.8" />
    <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" />
    <TextBlock Text="{Binding Copyright}" Opacity="0.7" />
    <Button Content="Project on GitHub" Command="{Binding OpenProjectCommand}" />
    <Button Content="Close" HorizontalAlignment="Right" Click="OnCloseClick" />
  </StackPanel>
</Window>

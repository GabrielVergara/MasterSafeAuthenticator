<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeAuthenticator.App.ViewModels"
             xmlns:conv="clr-namespace:SafeAuthenticator.App.Converters"
             x:Class="SafeAuthenticator.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
      <TextBlock Text="Encrypted backups (.sauth)" FontSize="22" FontWeight="SemiBold" />

      <TextBlock Text="Destination" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding Providers}"
                SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BackupProviderKind">
            <TextBlock Text="{Binding Converter={x:Static conv:BackupProviderKindConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- Local folder fields -->
      <TextBox Watermark="Backup folder"
               Text="{Binding Folder, Mode=TwoWay}"
               IsVisible="{Binding IsLocal}" />

      <!-- WebDAV cloud fields -->
      <StackPanel Spacing="8" IsVisible="{Binding IsWebDav}">
        <TextBox Watermark="WebDAV collection URL (https://.../backups/)"
                 Text="{Binding WebDavUrl, Mode=TwoWay}" />
        <TextBox Watermark="Username" Text="{Binding WebDavUser, Mode=TwoWay}" />
        <TextBox Watermark="Password" PasswordChar="•"
                 Text="{Binding WebDavPassword, Mode=TwoWay}" />
      </StackPanel>

      <TextBox Watermark="Master password (encrypts the backup)" PasswordChar="•"
               Text="{Binding MasterPassword, Mode=TwoWay}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Export" Command="{Binding ExportCommand}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="Import selected" Command="{Binding ImportCommand}" />
      </StackPanel>

      <TextBlock Text="Existing backups" FontWeight="SemiBold" />
      <ListBox ItemsSource="{Binding Backups}"
               SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
               Height="160" />

      <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

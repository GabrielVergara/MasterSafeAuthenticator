<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeAuthenticator.App.ViewModels"
             xmlns:core="clr-namespace:SafeAuthenticator.Core;assembly=SafeAuthenticator.Core"
             x:Class="SafeAuthenticator.App.Views.PasswordsView"
             x:DataType="vm:PasswordsViewModel">
  <Grid ColumnDefinitions="*,360">
    <DockPanel Grid.Column="0">
      <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Watermark="Search passwords"
               Text="{Binding SearchText, Mode=TwoWay}" />
      <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:PasswordEntry">
              <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{Binding UserName}" Opacity="0.7" />
                    <TextBlock Text="{Binding Url}" Opacity="0.5" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="User"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).CopyUserNameCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Password"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).CopyPasswordCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Edit"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Delete"
                            Command="{Binding $parent[ItemsControl].((vm:PasswordsViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
    <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Entry" FontSize="20" FontWeight="SemiBold" />
        <TextBox Watermark="Title" Text="{Binding Title, Mode=TwoWay}" />
        <TextBox Watermark="User name" Text="{Binding UserName, Mode=TwoWay}" />
        <TextBox Watermark="Password" PasswordChar="*" Text="{Binding Password, Mode=TwoWay}" />
        <Button Content="Generate strong password" Command="{Binding GenerateCommand}" />
        <TextBox Watermark="URL" Text="{Binding Url, Mode=TwoWay}" />
        <TextBox Watermark="Tags (comma separated)" Text="{Binding Tags, Mode=TwoWay}" />
        <TextBox Watermark="Notes" AcceptsReturn="True" Height="80" Text="{Binding Notes, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save" Command="{Binding SaveCommand}" />
          <Button Content="Clear" Command="{Binding ClearFormCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

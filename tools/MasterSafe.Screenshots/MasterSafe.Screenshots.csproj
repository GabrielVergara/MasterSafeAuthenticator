<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws the store screenshots without a screen, from a demo vault in a temporary folder. Not part of the release.
       Run: dotnet run, from the repository root, with the project tools/MasterSafe.Screenshots and the folder docs/screenshots -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(MasterSafeWindowsTarget)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MasterSafe.App\MasterSafe.App.csproj" />
  </ItemGroup>
</Project>

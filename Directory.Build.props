<Project>
  <!-- Windows builds use the Windows 10 API set (Windows Hello). Set -p:MasterSafeTargetOs=linux to build for Linux from any system. -->
  <PropertyGroup>
    <MasterSafeWindowsTarget Condition="'$(MasterSafeTargetOs)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">true</MasterSafeWindowsTarget>
    <MasterSafeWindowsTarget Condition="'$(MasterSafeTargetOs)' == 'windows'">true</MasterSafeWindowsTarget>
  </PropertyGroup>
  <!-- Exact package versions and hashes, checked by CI (scripts/update-lock-files.ps1 refreshes them). Windows and Linux target
       different frameworks, so each has its own file. Only with -p:MasterSafeLockFiles=true: publishing for a runtime needs other packages. -->
  <PropertyGroup Condition="'$(MasterSafeLockFiles)' == 'true'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(MasterSafeWindowsTarget)' == 'true'">packages.windows.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(MasterSafeWindowsTarget)' != 'true'">packages.linux.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<!-- Known-vulnerability gate: every build checks direct and transitive packages against the NuGet advisory database.
	     With TreatWarningsAsErrors a vulnerable package fails the build. NU1900 (advisory source unreachable, e.g. offline) stays a warning. -->
	<NuGetAudit>true</NuGetAudit>
	<NuGetAuditMode>all</NuGetAuditMode>
	<NuGetAuditLevel>low</NuGetAuditLevel>
	<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<AnalysisLevel>latest</AnalysisLevel>
	<GenerateDocumentationFile>false</GenerateDocumentationFile>
	<Deterministic>true</Deterministic>
	<Company>MasterSafe</Company>
	<Product>MasterSafe</Product>
	<Version>1.5.0</Version>
	<Authors>Gabriel Vergara Ezcurdia</Authors>
	<Copyright>Copyright (c) Gabriel Vergara Ezcurdia</Copyright>
  </PropertyGroup>
</Project>
